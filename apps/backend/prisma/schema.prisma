generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------
// ENUMS
// ------------------------------

enum Role {
  CUSTOMER
  MECHANIC
  ADMIN
}

enum RequestStatus {
  PENDING // waiting for a mechanic to accept
  ACCEPTED // mechanic accepted, en route
  ARRIVED // mechanic arrived at location
  IN_PROGRESS // service being performed
  COMPLETED
  CANCELLED
  NO_MECHANIC_FOUND
}

enum FareMode {
  AUTOMATIC
  CUSTOMER_OFFER
}

enum FareOfferStatus {
  NONE
  PENDING
  ACCEPTED
  REJECTED
}

enum ServiceCategory {
  TOWING
  FLAT_TIRE
  BATTERY_JUMP
  FUEL_DELIVERY
  LOCKOUT
  MECHANICAL_REPAIR
  WINCHING
  EV_CHARGING
}

enum VehicleClass {
  SMALL
  MEDIUM
  HEAVY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  CASH
}

enum MechanicVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  REQUEST_UPDATE
  PAYMENT
  PROMO
  SYSTEM
}

// ------------------------------
// MODELS
// ------------------------------

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  phone           String   @unique
  passwordHash    String
  fullName        String
  role            Role     @default(CUSTOMER)
  avatarUrl       String?
  isActive        Boolean  @default(true)
  isPhoneVerified Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  fcmToken        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicles           Vehicle[]
  requestsAsCustomer ServiceRequest[] @relation("CustomerRequests")
  mechanicProfile    MechanicProfile?
  ratingsGiven       Rating[]         @relation("RatingsGiven")
  notifications      Notification[]
  supportTickets     SupportTicket[]
  refreshTokens      RefreshToken[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
}

model MechanicProfile {
  id                 String                     @id @default(uuid())
  userId             String                     @unique
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationStatus MechanicVerificationStatus @default(PENDING)
  isOnline           Boolean                    @default(false)
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?
  serviceCategories  ServiceCategory[]
  licenseNumber      String?
  licenseDocUrl      String?
  vehicleDocUrl      String?
  insuranceDocUrl    String?
  rating             Float                      @default(0)
  totalJobsCompleted Int                        @default(0)
  walletBalance      Decimal                    @default(0) @db.Decimal(10, 2)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  requests ServiceRequest[] @relation("MechanicRequests")
  payouts  Payout[]
  ratings  Rating[]         @relation("RatingsReceived")

  @@index([isOnline])
  @@index([verificationStatus])
}

model Vehicle {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  make        String
  model       String
  year        Int
  plateNumber String
  color       String?
  vehicleType String // sedan, suv, motorcycle, truck, etc.
  createdAt   DateTime @default(now())

  requests ServiceRequest[]
}

model ServiceRequest {
  id         String           @id @default(uuid())
  customerId String
  customer   User             @relation("CustomerRequests", fields: [customerId], references: [id])
  mechanicId String?
  mechanic   MechanicProfile? @relation("MechanicRequests", fields: [mechanicId], references: [id])
  vehicleId  String?
  vehicle    Vehicle?         @relation(fields: [vehicleId], references: [id])

  category    ServiceCategory
  status      RequestStatus   @default(PENDING)
  description String?

  pickupLat     Float
  pickupLng     Float
  pickupAddress String
  dropLat       Float?
  dropLng       Float?
  dropAddress   String?

  estimatedFare Decimal? @db.Decimal(10, 2)
  finalFare     Decimal? @db.Decimal(10, 2)

  agreedFare Decimal? @db.Decimal(10, 2)

  fareMode              FareMode        @default(AUTOMATIC)
  customerRequestedFare Decimal?        @db.Decimal(10, 2)
  fareOfferStatus       FareOfferStatus @default(NONE)
  vehicleClass          VehicleClass    @default(SMALL)
  distanceTaxSnapshot   Decimal         @default(0) @db.Decimal(10, 2)
  distanceTaxRateSnapshot Decimal       @default(0) @db.Decimal(10, 2)

  distanceKm Decimal? @db.Decimal(10, 3)

  pricingBaseFareSnapshot  Decimal? @db.Decimal(10, 2)
  pricingPerKmRateSnapshot Decimal? @db.Decimal(10, 2)
  pricingMinFareSnapshot   Decimal? @db.Decimal(10, 2)
  pricingSurgeSnapshot     Float?
  pricingVersionSnapshot   Int?

  requestedAt  DateTime  @default(now())
  acceptedAt   DateTime?
  arrivedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  payment        Payment?
  rating         Rating?
  trackingPoints TrackingPoint[]
  chatMessages   ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([mechanicId])
}

model TrackingPoint {
  id         String         @id @default(uuid())
  requestId  String
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  heading    Float?
  recordedAt DateTime       @default(now())

  @@index([requestId])
}

model ChatMessage {
  id         String         @id @default(uuid())
  requestId  String
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId   String
  senderRole Role
  message    String
  sentAt     DateTime       @default(now())
  readAt     DateTime?

  @@index([requestId])
}

model Payment {
  id             String          @id @default(uuid())
  requestId      String          @unique
  request        ServiceRequest  @relation(fields: [requestId], references: [id])
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("INR")
  provider       PaymentProvider
  status         PaymentStatus   @default(PENDING)
  providerRef    String? // stripe/razorpay payment intent id
  platformFee    Decimal         @default(0) @db.Decimal(10, 2)
  mechanicPayout Decimal         @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(10, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Payout {
  id          String          @id @default(uuid())
  mechanicId  String
  mechanic    MechanicProfile @relation(fields: [mechanicId], references: [id])
  amount      Decimal         @db.Decimal(10, 2)
  status      PaymentStatus   @default(PENDING)
  providerRef String?
  requestedAt DateTime        @default(now())
  processedAt DateTime?
}

model Rating {
  id         String          @id @default(uuid())
  requestId  String          @unique
  request    ServiceRequest  @relation(fields: [requestId], references: [id])
  customerId String
  customer   User            @relation("RatingsGiven", fields: [customerId], references: [id])
  mechanicId String
  mechanic   MechanicProfile @relation("RatingsReceived", fields: [mechanicId], references: [id])
  stars      Int
  comment    String?
  createdAt  DateTime        @default(now())
}

model ServicePricing {
  id              String          @id @default(uuid())
  category        ServiceCategory @unique
  baseFare        Decimal         @db.Decimal(10, 2)
  perKmRate       Decimal         @db.Decimal(10, 2)
  minFare         Decimal         @db.Decimal(10, 2)
  surgeMultiplier Float           @default(1.0)
  pricingVersion  Int             @default(1)
  isActive        Boolean         @default(true)
  updatedAt       DateTime        @updatedAt
}

model VehicleTaxRule {
  vehicleClass VehicleClass @id
  perKmRate    Decimal     @default(0) @db.Decimal(10, 2)
  updatedAt    DateTime    @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
